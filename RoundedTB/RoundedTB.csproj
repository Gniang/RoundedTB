<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- "annotations" turns on the nullable context without emitting warnings for the
         ~4000 lines of not-yet-annotated legacy code. Types.cs opts into full checking
         locally via #nullable enable. Flip this to "enable" in the Phase 4 state-management
         rewrite, once the warnings are actionable rather than noise. -->
    <Nullable>annotations</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>RoundedTBCanary.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF-UI 1.2.1 and the UIAutomation COM interop assemblies ship no satellite
         resources we consume; trimming them keeps the output folder small. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Personal loopback-debugging configuration retained from the original project. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Remote Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>Z:\RTBDebug\bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DesktopBridge.Helpers" Version="1.2.1" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="WPF-UI" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="RoundedTB.ico" />
    <Resource Include="RoundedTBCanary.ico" />
    <Resource Include="RoundedTBDev.ico" />
    <Resource Include="res\TrayDark.ico" />
    <Resource Include="res\TrayLight.ico" />
    <Resource Include="res\HeadBanner.png" />
    <Resource Include="res\HeadBannerCan.png" />
    <Resource Include="res\HeadBannerDev.png" />
  </ItemGroup>

</Project>
